(ns learning.sim
  "Demo driver -- `kbb -M:dev:run`. Walks a clean learner through
  intake -> study-plan verification -> dropout-risk screening ->
  support-plan-finalization proposal (always escalates) -> human
  approval -> commit, then through guardian-contact proposal (always
  escalates) -> human approval -> commit, then shows five HARD holds
  (a jurisdiction with no spec-basis, an overloaded tutor cohort whose
  learner-to-tutor ratio exceeds its own maximum, an unresolved
  dropout risk screened directly via `:dropout-risk/screen` [never via
  an actuation op against an unscreened learner -- see this actor's
  own governor ns docstring / the lesson `parksafety`'s ADR-2607071922
  Decision 5, `eldercare`'s, `museum`'s, `conservation`'s, `salon`'s,
  `entertainment`'s, `casework`'s, `hospital`'s, `facility`'s,
  `school`'s, `association`'s, `leasing`'s, `behavioral`'s,
  `secondary`'s, `card`'s, `water`'s, `telecom`'s, `aerospace`'s,
  `recovery`'s, `consulting`'s, `union`'s, `congregation`'s, `fab`'s,
  `energy`'s, `care`'s and `navigator`'s ADR-0001s already recorded],
  and a double plan-finalization/guardian-contact of an already-
  processed learner) that never reach a human at all, and prints the
  audit ledger + the draft support-plan and guardian-contact records."
  (:require [langgraph.graph :as g]
            [learning.store :as store]
            [learning.operation :as op]))

(def operator {:actor-id "op-1" :actor-role :learning-coordinator :phase 3})

(defn- exec! [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "op-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        actor (op/build db)]
    (println "== learner/intake learner-1 (JPN, clean; cohort ratio 8:1 within max 12:1, no dropout risk) ==")
    (println (exec! actor "t1" {:op :learner/intake :subject "learner-1"
                                :patch {:id "learner-1" :learner-name "Sato Yui"}} operator))

    (println "== studyplan/verify learner-1 (escalates -- human approves) ==")
    (println (exec! actor "t2" {:op :studyplan/verify :subject "learner-1"} operator))
    (println (approve! actor "t2"))

    (println "== dropout-risk/screen learner-1 (clean; escalates -- human approves) ==")
    (println (exec! actor "t3" {:op :dropout-risk/screen :subject "learner-1"} operator))
    (println (approve! actor "t3"))

    (println "== actuation/finalize-support-plan learner-1 (always escalates -- actuation/finalize-support-plan) ==")
    (let [r (exec! actor "t4" {:op :actuation/finalize-support-plan :subject "learner-1"} operator)]
      (println r)
      (println "-- human learning-coordinator approves --")
      (println (approve! actor "t4")))

    (println "== actuation/contact-guardian learner-1 (always escalates -- actuation/contact-guardian) ==")
    (let [r (exec! actor "t5" {:op :actuation/contact-guardian :subject "learner-1"} operator)]
      (println r)
      (println "-- human learning-coordinator approves --")
      (println (approve! actor "t5")))

    (println "== studyplan/verify learner-2 (no spec-basis -> HARD hold) ==")
    (println (exec! actor "t6" {:op :studyplan/verify :subject "learner-2" :no-spec? true} operator))

    (println "== studyplan/verify learner-3 (escalates -- human approves; sets up the ratio-exceeded test) ==")
    (println (exec! actor "t7" {:op :studyplan/verify :subject "learner-3"} operator))
    (println (approve! actor "t7"))

    (println "== actuation/finalize-support-plan learner-3 (cohort ratio 15:1 > max 12:1 -> HARD hold) ==")
    (println (exec! actor "t8" {:op :actuation/finalize-support-plan :subject "learner-3"} operator))

    (println "== dropout-risk/screen learner-4 (unresolved -> HARD hold, never reaches a human) ==")
    (println (exec! actor "t9" {:op :dropout-risk/screen :subject "learner-4"} operator))

    (println "== actuation/finalize-support-plan learner-1 AGAIN (double-finalization -> HARD hold) ==")
    (println (exec! actor "t10" {:op :actuation/finalize-support-plan :subject "learner-1"} operator))

    (println "== actuation/contact-guardian learner-1 AGAIN (double-contact -> HARD hold) ==")
    (println (exec! actor "t11" {:op :actuation/contact-guardian :subject "learner-1"} operator))

    (println "== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "== draft support-plan records ==")
    (doseq [r (store/support-plan-history db)] (println r))

    (println "== draft guardian-contact records ==")
    (doseq [r (store/guardian-contact-history db)] (println r))))
